<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#dbe8ff">
<meta name="description" content="Interface premium de gestão, analytics, CRM, projetos, marketing e automação.">
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<title><%= title %></title>
<link rel="stylesheet" href="/css/studio.css">

</head>

<body>
<main class="page">
<section class="shell" aria-label="Painel de serviços">
<div class="scanline"></div>

<header class="nav reveal">
  <a class="brand" href="/" aria-label="Ir para a página inicial">
    <span class="logo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h6v3H8v4h3v3H5V4Zm8 0h6v10h-3V7h-3V4Zm-8 12h6v3H5v-3Zm8 0h6v4h-6v-4Z"/></svg>
    </span>
    <span>Joker Studio</span>
  </a>

  <nav class="nav-links" aria-label="Navegação principal">
    <a href="#services">Ferramentas</a>
    <a href="#services">Preços</a>
    <a href="#services">Funcionalidades</a>
    <a href="#contact">Contacto</a>
  </nav>

  <div class="nav-actions">
    <a class="btn" href="#services">Explorar</a>
    <a class="btn btn-dark" href="/">Início</a>
  </div>
</header>

<div class="subnav reveal" aria-label="Navegação secundária">
  <div class="sub-items">
    <span class="sub-item"><strong>Joker UI/UX</strong></span>
    <span class="chev">›</span>
    <span class="sub-item">Identidade Visual</span>
    <span class="sub-item">Social Media</span>
    <span class="sub-item">Web Design</span>
    <span class="sub-item">Mobile</span>
  </div>
  <div class="sub-tools">
    <button class="icon-btn" type="button" title="Guardar" aria-label="Guardar">♡</button>
    <span class="profile">Joker Studio</span>
  </div>
</div>

<section class="board" id="services">
  <div class="cards">

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/icon-wireframe.png" alt="Gestão"></div>
          <div class="media wide"><img src="/images/icon-uidesign.png" alt="Gestão visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar Gestão">♡</button>
      </div>
      <h2>Gestão</h2>
      <p>Organize processos, projetos e informação com uma experiência digital clara, elegante e eficiente.</p>
      <span class="price">desde 50 000 Kz</span>
    </article>

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/icon-illustration.png" alt="Data Analytics"></div>
          <div class="media wide"><img src="/images/icon-app.png" alt="Analytics visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar Data Analytics">♡</button>
      </div>
      <h2>Data Analytics</h2>
      <p>Transforme dados complexos em informação visual, dashboards e decisões mais inteligentes.</p>
      <span class="price">desde 50 000 Kz</span>
    </article>

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/icon-brand.png" alt="CRM Automation"></div>
          <div class="media wide"><img src="/images/roda.png" alt="CRM visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar CRM">♡</button>
      </div>
      <h2>CRM Automation</h2>
      <p>Crie experiências de relacionamento mais rápidas, consistentes e personalizadas para cada cliente.</p>
      <span class="price">desde 20 000 Kz</span>
    </article>

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/Chat.png" alt="Projeto"></div>
          <div class="media wide"><img src="/images/fogo.png" alt="Projeto visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar Projeto">♡</button>
      </div>
      <h2>Projeto</h2>
      <p>Planeamento visual, direção criativa e execução de projetos digitais com foco em resultados.</p>
      <span class="price">desde 20 000 Kz</span>
    </article>

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/next.png" alt="Marketing"></div>
          <div class="media wide"><img src="/images/icon-webapp.png" alt="Marketing visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar Marketing">♡</button>
      </div>
      <h2>Marketing</h2>
      <p>Conteúdo visual, campanhas e peças digitais pensadas para gerar atenção, confiança e conversão.</p>
      <span class="price">desde 20 000 Kz</span>
    </article>

    <article class="card reveal">
      <div class="card-head">
        <div class="card-images">
          <div class="media"><img src="/images/frf).png" alt="Automação"></div>
          <div class="media wide"><img src="/images/frf).png" alt="Automação visual"></div>
        </div>
        <button class="heart" type="button" aria-label="Favoritar Automação">♡</button>
      </div>
      <h2>Automação</h2>
      <p>Experiências digitais inteligentes para reduzir tarefas repetitivas e acelerar o seu fluxo de trabalho.</p>
      <span class="price">desde 20 000 Kz</span>
    </article>

  </div>
</section>

<footer class="footer" id="contact">
  <div class="foot-note">
    <span class="foot-mark">✦</span>
    <span>Design estratégico para marcas que querem<br>comunicar melhor e crescer.</span>
  </div>
  <div class="foot-center">Joker UI/UX · Branding · Digital Experience</div>
  <div class="socials">
    <a class="social" href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">◎</a>
    <a class="social dark" href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer" aria-label="TikTok">♫</a>
    <a class="social" href="https://www.behance.net/" target="_blank" rel="noopener noreferrer" aria-label="Behance">Bē</a>
    <a class="social" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
  </div>
</footer>

</section>
</main>


<script src="/js/studio.js"></script>
<script src="/js/core.js"></script>
</body>
</html>