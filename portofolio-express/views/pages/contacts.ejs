<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/contacts.css">
  
</head>
<body>

    <div class="bg-glow-radial"></div>
    <div class="ambient-purple-glow"></div>

    <!-- BOTÃO FLUTUANTE PARA VOLTAR À HOME COM LOGO -->
    <div class="floating-top-bar">
        <a href="/" class="logo-hurk">
            <img src="/images/logo.png" alt="Augusto Neves Logo" onerror="this.style.display='none'">
        </a>
        <a href="/" class="btn-back-index">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <span>Ir para Início</span>
        </a>
    </div>

    <div class="main-container">
        
        <!-- SEÇÃO DE CONTACTOS -->
        <div class="contact-page-wrapper">
            
            <h1 class="contact-main-title">Entre em Contacto Connosco</h1>
            <p class="contact-main-subtitle">Tem dúvidas ou precisa de soluções digitais? Envie-nos uma mensagem diretamente e entraremos em contacto!</p>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-box alert-success"><%= success %></div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-box alert-error"><%= error %></div>
            <% } %>

            <!-- Informações Rápidas -->
            <div class="contact-quick-info-grid">
                <div class="quick-info-element">
                    <span class="info-type">E-mail Principal</span>
                    <span class="info-value">augustoneve22@gmail.com</span>
                </div>
                <div class="quick-info-element">
                    <span class="info-type">Telefone / WhatsApp</span>
                    <span class="info-value">+244 927 825 820 / 974 120 856</span>
                </div>
            </div>

            <!-- Formulário -->
            <form class="contact-form-raw" action="/contactos" method="POST">
                
                <!-- Honeypot anti-spam invisível -->
                <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off">

                <div class="form-row-dual">
                    <div class="form-group-item">
                        <label>Primeiro Nome *</label>
                        <input type="text" name="firstName" placeholder="Ex: Augusto" required>
                    </div>
                    <div class="form-group-item">
                        <label>Último Nome *</label>
                        <input type="text" name="lastName" placeholder="Ex: Neves" required>
                    </div>
                </div>

                <div class="form-row-dual">
                    <div class="form-group-item">
                        <label>E-mail *</label>
                        <input type="email" name="email" placeholder="denyneves14@gmail.com" required>
                    </div>
                    <div class="form-group-item">
                        <label>Telemóvel</label>
                        <input type="text" name="phone" placeholder="+244 927 825 820">
                    </div>
                </div>

                <div class="form-group-item">
                    <label>Morada / Endereço</label>
                    <input type="text" name="address" placeholder="Luanda, Angola">
                </div>

                <div class="form-group-item">
                    <label>Mensagem / Detalhes do Projeto *</label>
                    <textarea name="message" placeholder="Olá Augusto, gostaria de ajuda com..." required></textarea>
                </div>

                <div class="location-info-text">
                    <strong>Localização:</strong> Luanda, Angola (Via Expressa, Paragem da Mutamba / Bita).
                </div>

                <button type="submit" class="btn-submit-form">Enviar Mensagem</button>

            </form>

        </div>

    </div>

    <!-- ===== FOOTER SUPREMO COMPLETO ===== -->
    <div class="footer-supreme-container">
        
        <!-- BANNER DE DOWNLOAD -->
        <div class="download-banner-card">
            <div class="banner-decor-left"></div>
            <div class="banner-decor-right"></div>
            <div class="banner-inner-content">
                <h2>Baixar Joker UI Brevemente</h2>
                <p>Aproveite ao máximo o seu tempo livre e comece a ganhar prémios!</p>
                <div class="store-badges-row">
                    <a href="https://play.google.com" target="_blank" class="store-badge-btn">
                        <img src="/images/googleplay.png" alt="Google Play" onerror="this.style.display='none'">
                        <div class="store-text-info">
                            <span class="small-txt">Descarregar em</span>
                            <span class="store-name">Google Play</span>
                        </div>
                    </a>
                    <a href="https://apple.com/app-store" target="_blank" class="store-badge-btn">
                        <img src="/images/app.png" alt="App Store" onerror="this.style.display='none'">
                        <div class="store-text-info">
                            <span class="small-txt">Descarregar na</span>
                            <span class="store-name">App Store</span>
                        </div>
                    </a>
                </div>
                <div class="banner-stats-grid">
                    <div class="stat-box"><h3>+4K</h3><p>Utilizadores Registados</p></div>
                    <div class="stat-box"><h3>+2K</h3><p>Projetos Criados</p></div>
                    <div class="stat-box"><h3>+5K</h3><p>Participações Totais</p></div>
                    <div class="stat-box"><h3>+10K</h3><p>Prémios Atribuídos</p></div>
                </div>
            </div>
        </div>

        <!-- FOOTER INFERIOR -->
        <div class="footer-bottom-grid">
            <div class="footer-col-brand">
                <div class="footer-logo-area">
                    <img src="/images/favicon.png" alt="Logo" onerror="this.style.display='none'">
                    Joker UI
                </div>
                <p>Utilize o seu tempo livre com a Joker UI e ganhe recompensas ao concluir várias missões e projetos.</p>
                
                <div class="footer-social-row">
                <a href="https://www.facebook.com/denyneves.francisco/" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a>
                <a href="https://www.instagram.com/denyitachi14/" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
                <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="X"><svg viewBox="0 0 24 24"><path d="M4 4l11.733 16h4.267l-11.733 -16zM4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg></a>
                <a href="https://www.linkedin.com/in/augusto-neves-134271369/" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
                <a href="https://www.youtube.com/@NerdsAI-b9l" target="_blank" rel="noopener noreferrer" class="social-circle-link" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#ffffff" stroke="none"></polygon></svg></a>
            </div>
            </div>

            <div class="footer-nav-col">
                <h4>Explorar</h4>
                <ul>
                    <li><a href="/">Início</a></li>
                    <li><a href="/projetos">Projetos</a></li>
                    <li><a href="/contactos">Contacto</a></li>
                </ul>
            </div>

            <div class="footer-nav-col">
                <h4>Legal</h4>
                <ul>
                    <li><a href="/acordo">Acordo de Utilizador</a></li>
                    <li><a href="/politic">Política de Privacidade</a></li>
                    <li><a href="/cookies">Política de Cookies</a></li>
                </ul>
            </div>
        </div>

        <!-- BARRA DE COPYRIGHT -->
        <div class="footer-final-bar">
            <p>© <span id="current-year"></span> JOKER UI TECHNOLOGIES. Todos os direitos reservados.</p>
            <a href="mailto:augustoneve22@gmail.com" class="support-email-link">
                augustoneve22@gmail.com
            </a>
        </div>

    </div>

    <script src="/js/core.js"></script>
    <script>
        document.getElementById('current-year').textContent = new Date().getFullYear();
    </script>

</body>
</html>