<script>
(function(){
  "use strict";

  const body = document.body;
  const themeBtn = document.getElementById("themeBtn");
  const mobileToggle = document.getElementById("mobileToggle");
  const nav = document.querySelector(".nav-links");

  const savedTheme = localStorage.getItem("aotravel-theme");
  if(savedTheme === "light"){
    body.classList.add("light");
    themeBtn.textContent = "";
  }
  themeBtn.addEventListener("click", function(){
    body.classList.toggle("light");
    const light = body.classList.contains("light");
    themeBtn.textContent = light ? "" : "";
    localStorage.setItem("aotravel-theme", light ? "light" : "dark");
  });

  mobileToggle.addEventListener("click", function(){
    const opened = nav.classList.toggle("mobile-open");
    nav.style.display = opened ? "flex" : "";
    nav.style.position = opened ? "absolute" : "";
    nav.style.top = opened ? "70px" : "";
    nav.style.left = opened ? "10px" : "";
    nav.style.right = opened ? "10px" : "";
    nav.style.padding = opened ? "10px" : "";
    nav.style.flexDirection = opened ? "column" : "";
    nav.style.alignItems = opened ? "stretch" : "";
    nav.style.background = opened ? "rgba(12,9,18,.96)" : "";
    nav.style.border = opened ? "1px solid rgba(255,255,255,.1)" : "";
    nav.style.borderRadius = opened ? "14px" : "";
    nav.style.backdropFilter = opened ? "blur(20px)" : "";
  });

  document.querySelectorAll(".nav-links a").forEach(function(link){
    link.addEventListener("click", function(){
      nav.classList.remove("mobile-open");
      if(window.innerWidth <= 850) nav.style.display = "none";
    });
  });

  const revealItems = document.querySelectorAll(".reveal,.reveal-left,.reveal-right");
  const observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add("show");
        observer.unobserve(entry.target);
      }
    });
  }, {threshold:.12, rootMargin:"0px 0px -55px 0px"});
  revealItems.forEach(function(el){ observer.observe(el); });

  const parallaxItems = document.querySelectorAll("[data-parallax]");
  let ticking = false;
  function updateParallax(){
    const scrollY = window.scrollY;
    parallaxItems.forEach(function(el){
      const speed = parseFloat(el.getAttribute("data-parallax")) || 0;
      const rect = el.getBoundingClientRect();
      const center = rect.top + rect.height / 2 - window.innerHeight / 2;
      const amount = center * speed;
      el.style.transform = "translate3d(0," + (-amount) + "px,0)";
    });
    ticking = false;
  }
  window.addEventListener("scroll", function(){
    if(!ticking){
      window.requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }, {passive:true});
  updateParallax();

  document.querySelectorAll(".btn-aot").forEach(function(btn){
    btn.addEventListener("mousemove", function(e){
      if(window.matchMedia("(pointer:fine)").matches){
        const r = btn.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width/2) * .12;
        const y = (e.clientY - r.top - r.height/2) * .12;
        btn.style.transform = "translate(" + x + "px," + y + "px)";
      }
    });
    btn.addEventListener("mouseleave", function(){
      btn.style.transform = "";
    });
  });

  const galleryImage = document.getElementById("galleryImage");
  const galleryButtons = document.querySelectorAll("[data-gallery]");
  const gallerySources = {
    app: "/images/app.png",
    screen: "/images/screen.png",
    web: "/images/web.png"
  };
  galleryButtons.forEach(function(button){
    button.addEventListener("click", function(){
      galleryButtons.forEach(b => b.classList.remove("active"));
      button.classList.add("active");
      const key = button.getAttribute("data-gallery");
      galleryImage.style.opacity = "0";
      galleryImage.style.transform = "scale(.94) translateY(12px)";
      setTimeout(function(){
        galleryImage.src = gallerySources[key];
        galleryImage.style.opacity = "1";
        galleryImage.style.transform = "scale(1) translateY(0)";
      },220);
    });
  });
  galleryImage.style.transition = "opacity .35s ease,transform .45s cubic-bezier(.2,.75,.2,1)";

  document.querySelectorAll("img").forEach(function(img){
    img.addEventListener("error", function(){
      if(img.dataset.fallbackApplied) return;
      img.dataset.fallbackApplied = "1";
      img.style.visibility = "hidden";
      img.parentElement.classList.add("asset-missing");
      if(!img.parentElement.querySelector(".asset-label")){
        const label = document.createElement("span");
        label.className = "asset-label";
        label.textContent = "AOTRAVEL";
        label.style.cssText = "position:absolute;inset:0;display:grid;place-items:center;color:#ffb87a;font-size:10px;letter-spacing:.18em;text-transform:uppercase";
        img.parentElement.style.position = "relative";
        img.parentElement.appendChild(label);
      }
    });
  });

  const counters = document.querySelectorAll("[data-count]");
  const counterObserver = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting) return;
      const el = entry.target;
      const target = Number(el.dataset.count);
      const suffix = el.textContent.replace(/[0-9.]/g,"");
      let start = 0;
      const duration = 1100;
      const begin = performance.now();
      function tick(now){
        const progress = Math.min((now-begin)/duration,1);
        const eased = 1-Math.pow(1-progress,4);
        el.textContent = Math.round(start+(target-start)*eased) + suffix;
        if(progress<1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
      counterObserver.unobserve(el);
    });
  }, {threshold:.7});
  counters.forEach(el => counterObserver.observe(el));

  document.querySelectorAll(".feature-card,.plan,.quote-card,.small-card").forEach(function(card){
    card.addEventListener("mousemove", function(e){
      if(!window.matchMedia("(pointer:fine)").matches) return;
      const r = card.getBoundingClientRect();
      const x = (e.clientX-r.left)/r.width-.5;
      const y = (e.clientY-r.top)/r.height-.5;
      card.style.transform = "perspective(700px) rotateX(" + (-y*2.2) + "deg) rotateY(" + (x*2.2) + "deg) translateY(-5px)";
    });
    card.addEventListener("mouseleave", function(){
      card.style.transform = "";
    });
  });

  document.addEventListener("keydown", function(e){
    if(e.key === "Escape"){
      nav.classList.remove("mobile-open");
      if(window.innerWidth <= 850) nav.style.display = "none";
    }
  });

  document.querySelectorAll(".footer-bottom").forEach(function(el){
    el.innerHTML = el.innerHTML.replace("© 2026","© " + new Date().getFullYear());
  });
})();
</script>
<script src="/js/core.js"></script>
</body>
</html>