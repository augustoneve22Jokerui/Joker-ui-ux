<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Joker UI/UX — Social Media Print' %></title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================
           JOKER UI/UX — FULL VIEWPORT & CAROUSEL BACKGROUND SYSTEM
           ========================================================== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body {
            width: 100vw; height: 100vh; height: 100dvh;
            overflow: hidden; background-color: #050308;
            color: #f3f0f7; font-family: 'Inter', sans-serif;
        }

        /* Botão Voltar à Home */
        .home-button {
            position: fixed; top: 18px; left: 24px; z-index: 100;
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 14px; border: 1px solid rgba(167, 139, 250, 0.3);
            border-radius: 50px; background: rgba(14, 9, 20, 0.75);
            color: #fff; font-size: 0.75rem; font-weight: 600;
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            text-decoration: none;
            transition: all 0.25s ease;
        }
        .home-button:hover {
            border-color: rgba(167, 139, 250, 0.8);
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(139, 92, 246, 0.3);
        }
        .home-button .arrow { color: #c4b5fd; font-size: 13px; }

        /* Sistema de Carrossel de Fundos Fixos + Vídeo */
        .bg-video-layer {
            position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover;
            z-index: -3; opacity: 0.15; pointer-events: none; filter: brightness(0.4) contrast(1.1);
        }
        .hero-bg-slide {
            position: fixed; inset: 0; width: 100%; height: 100%;
            background-size: cover; background-position: center;
            opacity: 0; transform: scale(1.04);
            transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1), transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: -2;
        }
        .hero-bg-slide.active { opacity: 1; transform: scale(1); }
        
        .page-overlay {
            position: fixed; inset: 0; z-index: -1; pointer-events: none;
            background: linear-gradient(135deg, rgba(5, 3, 8, 0.90) 0%, rgba(5, 3, 8, 0.78) 50%, rgba(14, 9, 24, 0.88) 100%),
                        radial-gradient(circle at 50% 15%, rgba(139, 92, 246, 0.25) 0%, transparent 65%);
        }

        /* Contentor Principal Fixo no Viewport */
        .viewport-container {
            width: 100%; height: 100%; max-width: 1380px;
            margin: 0 auto; padding: 18px 30px;
            display: flex; flex-direction: column; justify-content: space-between;
        }

        /* Topo Minimalista SaaS */
        .top-brand-bar {
            display: flex; justify-content: flex-end; align-items: center;
            padding-bottom: 10px; border-bottom: 1px solid rgba(139, 92, 246, 0.18);
        }
        .brand-badge {
            background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(167, 139, 250, 0.35);
            color: #c4b5fd; font-size: 0.7rem; font-weight: 600; padding: 4px 14px; border-radius: 20px;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
        }

        /* ==========================================================
           GRID DE 8 POSTS (4 EM CIMA, 4 EM BAIXO) - CARDS AMPLIADOS
           ========================================================== */
        .feed-grid-8 {
            display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 1fr);
            gap: 16px; flex: 1; align-items: center; margin: 10px 0; max-height: calc(100vh - 110px);
        }

        .insta-card {
            background: rgba(15, 10, 24, 0.82);
            backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(139, 92, 246, 0.25);
            border-radius: 16px; overflow: hidden;
            display: flex; flex-direction: column; height: 100%; max-height: 100%;
            box-shadow: 0 15px 35px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.08);
            transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
        }
        .insta-card:hover {
            border-color: rgba(167, 139, 250, 0.6);
            transform: translateY(-3px);
            box-shadow: 0 20px 45px rgba(0,0,0,0.7), 0 0 25px rgba(139, 92, 246, 0.3);
        }

        /* Cabeçalho do Post com Foto de Perfil Real */
        .insta-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.05);
            background: rgba(22, 15, 35, 0.5);
        }
        .insta-user { display: flex; align-items: center; gap: 8px; }
        .insta-avatar-img {
            width: 26px; height: 26px; border-radius: 50%; object-fit: cover;
            border: 1px solid rgba(167, 139, 250, 0.5);
            box-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
        }
        .insta-username { font-size: 0.75rem; font-weight: 600; color: #fff; }
        .insta-dots { color: #887a9e; font-size: 0.8rem; cursor: pointer; }

        /* Mídia do Post (Com suporte a clique direto) */
        .insta-media {
            position: relative; width: 100%; flex: 1; min-height: 0;
            background: #040206; overflow: hidden; cursor: zoom-in;
        }
        .insta-media img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 0.5s ease; pointer-events: none;
        }
        .insta-card:hover .insta-media img { transform: scale(1.04); }

        /* Ações */
        .insta-actions {
            display: flex; justify-content: space-between; align-items: center;
            padding: 6px 12px 2px;
        }
        .insta-actions-left { display: flex; gap: 10px; align-items: center; }
        .action-icon {
            background: none; border: none; color: #cbd5e1; cursor: pointer;
            display: flex; align-items: center; transition: color 0.2s, transform 0.2s;
        }
        .action-icon:hover { color: #a78bfa; transform: scale(1.1); }
        .action-icon svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none; }
        .action-icon.liked svg { fill: #ef4444; stroke: #ef4444; }

        /* Legenda */
        .insta-caption {
            padding: 0 12px 8px; font-size: 0.7rem; line-height: 1.35; color: #94a3b8;
        }
        .insta-caption strong { color: #fff; font-weight: 600; }
        .insta-likes { font-size: 0.65rem; font-weight: 600; color: #e2e8f0; margin-bottom: 2px; }

        /* ==========================================================
           LIGHTBOX PARA TELA CHEIA (TAMANHO REAL)
           ========================================================== */
        .image-lightbox {
            position: fixed; inset: 0; z-index: 1000;
            display: flex; align-items: center; justify-content: center;
            background: rgba(4, 2, 7, 0.94); backdrop-filter: blur(20px);
            opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        .image-lightbox.open { opacity: 1; visibility: visible; }
        .lightbox-content {
            max-width: min(92vw, 900px); max-height: 85vh;
            position: relative; display: flex; align-items: center; justify-content: center;
        }
        .lightbox-content img {
            max-width: 100%; max-height: 85vh; object-fit: contain;
            border-radius: 12px; box-shadow: 0 25px 60px rgba(0,0,0,0.8), 0 0 40px rgba(139, 92, 246, 0.3);
        }
        .lightbox-close {
            position: absolute; top: -45px; right: 0; background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2); color: #fff; width: 36px; height: 36px;
            border-radius: 50%; font-size: 1.2rem; display: grid; place-items: center; cursor: pointer;
            transition: background 0.2s;
        }
        .lightbox-close:hover { background: #8b5cf6; }

        /* Responsividade */
        @media (max-width: 1200px) {
            .feed-grid-8 { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(4, 1fr); }
            html, body { overflow-y: auto; height: auto; }
        }
        @media (max-width: 600px) {
            .feed-grid-8 { grid-template-columns: 1fr; grid-template-rows: repeat(8, auto); }
        }
    </style>
</head>
<body>

    <!-- Botão Voltar à Home -->
    <a href="/" class="home-button" aria-label="Voltar para a página inicial">
        <span class="arrow">←</span><span>Voltar à Home</span>
    </a>

    <!-- Vídeo & Carrossel de Fundos Fixos -->
    <video class="bg-video-layer" autoplay muted loop playsinline aria-hidden="true">
        <source src="/images/background.mp4" type="video/mp4">
    </video>
    <div class="hero-bg-slide active" style="background-image: url('/images/fundo.png');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/fundo1.png');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/fundo2.png');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/fundo3.png');"></div>
    <div class="page-overlay"></div>

    <div class="viewport-container">
        <!-- Topo com Badge -->
        <header class="top-brand-bar">
            <div class="brand-badge">Curadoria Exclusiva (8 Artes)</div>
        </header>

        <!-- Matriz de 8 Posts (4 em cima, 4 em baixo) -->
        <section class="feed-grid-8">
            <% 
              const posts8 = [
                { user: "joker.uiux", img: "images/card-01.jpg", likes: "1,248", title: "Design fraco", desc: "faz você perder clientes valiosos. Confiança constrói-se com padrão." },
                { user: "joker.uiux", img: "images/card-02.jpg", likes: "892", title: "Impulso estratégico", desc: "Dê movimento e identidade forte à sua marca no digital." },
                { user: "joker.uiux", img: "images/card-03.jpg", likes: "1,530", title: "Eleve o conteúdo", desc: "Sua marca merece destaque absoluto. Supere o silêncio digital." },
                { user: "joker.uiux", img: "images/card-04.jpg", likes: "945", title: "Sua marca ouvida", desc: "Posicionamento gráfico alinhado aos seus objetivos de negócio." },
                { user: "joker.uiux", img: "images/card-05.jpg", likes: "2,110", title: "Planeamento sólido", desc: "Marcas fortes não improvisam. Estratégia em cada detalhe visual." },
                { user: "joker.uiux", img: "images/card-06.jpg", likes: "1,120", title: "Clareza no digital", desc: "Elimine a confusão dos clientes com um design limpo e assertivo." },
                { user: "joker.uiux", img: "images/mulher.png", likes: "1,410", title: "Autoridade visual", desc: "Diferencie-se da concorrência com peças gráficas de alto nível." },
                { user: "joker.uiux", img: "images/16.png", likes: "1,890", title: "Conversão real", desc: "Estética aliada à conversão para multiplicar os seus resultados." }
              ];
            %>

            <% posts8.forEach(post => { %>
                <article class="insta-card">
                    <!-- Header do Post com Foto de Perfil Real -->
                    <div class="insta-header">
                        <div class="insta-user">
                            <img src="/images/avatar.png" alt="Avatar" class="insta-avatar-img" onerror="this.src='/images/favicon.png'">
                            <span class="insta-username"><%= post.user %></span>
                        </div>
                        <div class="insta-dots">&bull;&bull;&bull;</div>
                    </div>

                    <!-- Mídia com evento de clique corrigido -->
                    <div class="insta-media" data-img-src="/<%= post.img %>">
                        <img src="/<%= post.img %>" alt="<%= post.title %>" loading="lazy" onerror="this.src='/images/fundo.png'">
                    </div>

                    <!-- Barra de Ações -->
                    <div class="insta-actions">
                        <div class="insta-actions-left">
                            <button class="action-icon" onclick="this.classList.toggle('liked')">
                                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>
                            <button class="action-icon">
                                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            </button>
                            <button class="action-icon">
                                <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                            </button>
                        </div>
                        <button class="action-icon">
                            <svg viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                        </button>
                    </div>

                    <!-- Legenda -->
                    <div class="insta-caption">
                        <div class="insta-likes">Curtido por <strong><%= post.likes %> pessoas</strong></div>
                        <div><strong><%= post.title %></strong> <%= post.desc %></div>
                    </div>
                </article>
            <% }) %>
        </section>

        <!-- Rodapé compacto -->
        <footer style="text-align: center; font-size: 0.7rem; color: #887a9e; padding-top: 4px;">
            &copy; 2026 Joker UI/UX &bull; Curadoria Gráfica de Elite
        </footer>
    </div>

    <!-- Modal Lightbox (Tamanho Real) -->
    <div class="image-lightbox" id="imageLightbox">
        <div class="lightbox-content">
            <button class="lightbox-close" id="lightboxCloseBtn">&times;</button>
            <img id="lightboxImg" src="" alt="Visualização em Tamanho Real">
        </div>
    </div>

    <!-- Script Robusto -->
    <script>
        // 1. Carrossel Automático de Fundos
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-bg-slide');
        function nextBgSlide() {
            if(!slides.length) return;
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }
        setInterval(nextBgSlide, 6000);

        // 2. Sistema de Lightbox Corrigido
        const lightbox = document.getElementById('imageLightbox');
        const lightboxImg = document.getElementById('lightboxImg');
        const closeBtn = document.getElementById('lightboxCloseBtn');

        document.querySelectorAll('.insta-media').forEach(mediaBox => {
            mediaBox.addEventListener('click', () => {
                const src = mediaBox.getAttribute('data-img-src');
                if(src) {
                    lightboxImg.src = src;
                    lightbox.classList.add('open');
                }
            });
        });

        function closeLightbox() {
            lightbox.classList.remove('open');
            lightboxImg.src = '';
        }

        closeBtn.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => {
            if(e.target === lightbox) closeLightbox();
        });

        document.addEventListener('keydown', (e) => {
            if(e.key === 'Escape') closeLightbox();
        });
    </script>
</body>
</html>