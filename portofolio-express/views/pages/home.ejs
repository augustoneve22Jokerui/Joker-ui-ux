                            <span class="num">+125</span>
                            <span class="lbl">Clientes</span>
                        </div>
                        <div class="hero-mini-stat">
                            <span class="num">+210</span>
                            <span class="lbl">Projetos</span>
                        </div>
                        <div class="hero-mini-stat">
                            <span class="num">5★</span>
                            <span class="lbl">Avaliação</span>
                        </div>
                    </div>
