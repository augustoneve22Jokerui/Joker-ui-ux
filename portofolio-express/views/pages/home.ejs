        </a>
        <ul class="nav-menu">
            <li><a href="/" class="<%= activePage === 'home' ? 'active' : '' %>">Início</a></li>
            <li><a href="/projetos" class="<%= activePage === 'projects' ? 'active' : '' %>">Projectos <span class="nav-badge">12</span></a></li>
