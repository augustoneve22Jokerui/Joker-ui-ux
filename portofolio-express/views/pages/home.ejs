                    <img src="/images/figma.png" alt="Figma" class="float-icon icon-figma" onerror="this.style.display='none'">
                    <img src="/images/Bootstrap.png" alt="Next.js" class="float-icon icon-next" onerror="this.style.display='none'">
                    <img src="/images/xd.png" alt="Bootstrap" class="float-icon icon-bootstrap" onerror="this.style.display='none'">
