<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="stylesheet" href="/css/stand.css">
    
</head>
<body class="fillo-app-body">

    <nav class="navbar-custom">
        <a href="/" class="navbar-brand-custom">
            <i class="fa-solid fa-bolt-lightning text-primary"></i> filllo
        </a>
        
        <div class="nav-links d-none d-md-flex">
            <a href="/" class="active" onclick="mudarAba(event, 'Início')"><i class="fa-solid fa-house"></i> Início</a>
            <a href="/projetos" onclick="mudarAba(event, 'Carros')"><i class="fa-solid fa-car"></i> Carros</a>
            <a href="/contactos" onclick="mudarAba(event, 'Concessionárias')"><i class="fa-solid fa-user-tie"></i> Concessionárias</a>
            <a href="#" onclick="mudarAba(event, 'Mensagens')"><i class="fa-solid fa-comment-dots"></i> Mensagens <span class="badge bg-success rounded-pill" style="font-size:9px;">10+</span></a>
            <a href="#" onclick="mudarAba(event, 'Histórico')"><i class="fa-solid fa-clock-rotate-left"></i> Histórico</a>
        </div>

        <div class="nav-right">
            <button class="btn-circle-green" title="Adicionar Veículo" onclick="mostrarAlerta('Abrindo painel para adicionar novo veículo...')"><i class="fa-solid fa-plus"></i></button>
            <div class="position-relative">
                <i class="fa-regular fa-bell notification-icon" title="Notificações" onclick="mostrarAlerta('Você não possui novas notificações no momento.')"></i>
                <span class="fillo-notification-dot"></span>
            </div>
            <div class="user-profile" onclick="mostrarAlerta('Perfil de Leslie Alexander selecionado.')">
                <img src="/images/Leslie.png" onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100'" alt="Usuário">
                <i class="fa-solid fa-chevron-down" style="font-size: 11px; color: #9ca3af; margin-left: 4px;"></i>
            </div>
        </div>
    </nav>

    <div class="hero-section">
        <h1 class="hero-title">Dirija o Carro dos seus Sonhos</h1>
        
        <div class="search-card">
            <div class="search-field" onclick="mostrarAlerta('Selecionando Marca...')">
                <span class="search-label">Marca do Carro</span>
                <div class="search-value">
                    Porsche <i class="fa-solid fa-chevron-down text-muted" style="font-size: 12px;"></i>
                </div>
            </div>
            <div class="search-field" onclick="mostrarAlerta('Selecionando Modelo...')">
                <span class="search-label">Modelo do Carro</span>
                <div class="search-value">
                    Qualquer <i class="fa-solid fa-chevron-down text-muted" style="font-size: 12px;"></i>
                </div>
            </div>
            <div class="search-field" onclick="mostrarAlerta('Selecionando Local de Retirada...')">
                <span class="search-label">Local de Retirada</span>
                <div class="search-value">
                    Aeroporto John F. Kennedy <i class="fa-solid fa-chevron-down text-muted" style="font-size: 12px;"></i>
                </div>
            </div>
            <div class="search-field" onclick="mostrarAlerta('Selecionando Datas...')">
                <span class="search-label">Data de Retirada e Devolução</span>
                <div class="search-value">
                    27 Abr - 1 Mai <i class="fa-regular fa-calendar text-muted" style="font-size: 14px;"></i>
                </div>
            </div>
            <div>
                <button class="btn-search" onclick="realizarBusca()">
                    <i class="fa-solid fa-magnifying-glass"></i> Pesquisar
                </button>
            </div>
        </div>
    </div>

    <div class="main-content-area">
        <div class="section-header">
            <h2 class="section-title"><i class="fa-solid fa-fire text-danger"></i> Carros Populares</h2>
            <a href="#" class="see-all" onclick="mostrarAlerta('Carregando coleção completa de carros populares...')">Ver Toda a Coleção <i class="fa-solid fa-chevron-right" style="font-size: 11px;"></i></a>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="car-card-popular gradient-blue" onclick="alugarCarro('Porsche 911 Turbo S')">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">Porsche 911</h5>
                            <small class="text-muted" style="font-size: 12px;">Turbo S - 2021</small>
                        </div>
                        <span class="badge-status">2 Unidades disponíveis</span>
                    </div>
                    <div class="car-img-container">
                        <img src="/images/01.png" onerror="this.src='https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?w=600'" alt="Porsche 911">
                    </div>
                    <div class="car-footer-info">
                        <div class="dealer-info">
                            <img src="/images/dealer1.png" onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100'" class="dealer-avatar" alt="Leslie">
                            <div>
                                <p class="dealer-name">Leslie Alexander</p>
                                <p class="dealer-type"><i class="fa-solid fa-circle-check text-primary" style="font-size: 10px;"></i> Usuário Verificado</p>
                            </div>
                        </div>
                        <div class="price-tag">$950<span>/dia</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="car-card-popular gradient-gray" onclick="alugarCarro('Nissan GT-R 2023')">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">Nissan GT-R 2023</h5>
                            <small class="text-muted" style="font-size: 12px;">Nismo 3.8 V6</small>
                        </div>
                        <span class="badge-status badge-arriving">Chegando em breve</span>
                    </div>
                    <div class="car-img-container">
                        <img src="/images/02.png" onerror="this.src='https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?w=600'" alt="Nissan GTR">
                    </div>
                    <div class="car-footer-info">
                        <div class="dealer-info">
                            <img src="/images/dealer2.png" onerror="this.src='https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100'" class="dealer-avatar" alt="Rebel">
                            <div>
                                <p class="dealer-name">Rebel Automotive</p>
                                <p class="dealer-type"><i class="fa-solid fa-circle-check text-primary" style="font-size: 10px;"></i> Concessionária Autorizada</p>
                            </div>
                        </div>
                        <div class="price-tag">$1260<span>/dia</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="car-card-popular gradient-pink" onclick="alugarCarro('Chevrolet C8 Corvette')">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">Chevrolet C8</h5>
                            <small class="text-muted" style="font-size: 12px;">Corvette Stingray</small>
                        </div>
                        <span class="badge-status badge-reserved">Reservado</span>
                    </div>
                    <div class="car-img-container">
                        <img src="/images/03.png" onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=600'" alt="Chevrolet C8">
                    </div>
                    <div class="car-footer-info">
                        <div class="dealer-info">
                            <img src="/images/dealer3.png" onerror="this.src='https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=100'" class="dealer-avatar" alt="RentCar">
                            <div>
                                <p class="dealer-name">RentCar</p>
                                <p class="dealer-type"><i class="fa-solid fa-circle-check text-primary" style="font-size: 10px;"></i> Concessionária Autorizada</p>
                            </div>
                        </div>
                        <div class="price-tag">$800<span>/dia</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-header">
            <h2 class="section-title"><i class="fa-solid fa-car-side text-primary"></i> Nossa Coleção</h2>
            <a href="#" class="see-all" onclick="mostrarAlerta('Carregando catálogo completo...')">Ver Toda a Coleção <i class="fa-solid fa-chevron-right" style="font-size: 11px;"></i></a>
        </div>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="car-card-collection" onclick="alugarCarro('911 Carrera GTS')">
                    <h6 class="fw-bold mb-0">911 Carrera GTS</h6>
                    <small class="text-muted" style="font-size: 11px;">Tipo 992</small>
                    <div class="car-img-container" style="height: 110px; margin: 15px 0;">
                        <img src="/images/4.png" onerror="this.src='https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?w=400'" alt="911 Carrera">
                    </div>
                    <div class="collection-specs">
                        <span><i class="fa-solid fa-user"></i> 2</span>
                        <span><i class="fa-solid fa-gear"></i> M.</span>
                        <span><i class="fa-solid fa-droplet"></i> 200m/d</span>
                    </div>
                    <div class="car-footer-info pt-2">
                        <div class="price-tag" style="font-size: 16px;">$150<span>/hora</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="car-card-collection" onclick="alugarCarro('Porsche Taycan')">
                    <h6 class="fw-bold mb-0">Porsche Taycan</h6>
                    <small class="text-muted" style="font-size: 11px;">2/4, 4s</small>
                    <div class="car-img-container" style="height: 110px; margin: 15px 0;">
                        <img src="/images/5.png" onerror="this.src='https://images.unsplash.com/photo-1617788138017-80ad40651399?w=400'" alt="Taycan">
                    </div>
                    <div class="collection-specs">
                        <span><i class="fa-solid fa-user"></i> 2</span>
                        <span><i class="fa-solid fa-gear"></i> M.</span>
                        <span><i class="fa-solid fa-droplet"></i> 200m/d</span>
                    </div>
                    <div class="car-footer-info pt-2">
                        <div class="price-tag" style="font-size: 16px;">$950<span>/dia</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="car-card-collection" onclick="alugarCarro('Panamera 4.4s')">
                    <h6 class="fw-bold mb-0">Panamera 4.4s</h6>
                    <small class="text-muted" style="font-size: 11px;">E-Híbrido</small>
                    <div class="car-img-container" style="height: 110px; margin: 15px 0;">
                        <img src="/images/6.png" onerror="this.src='https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=400'" alt="Panamera">
                    </div>
                    <div class="collection-specs">
                        <span><i class="fa-solid fa-user"></i> 4</span>
                        <span><i class="fa-solid fa-gear"></i> M.</span>
                        <span><i class="fa-solid fa-droplet"></i> 200m/d</span>
                    </div>
                    <div class="car-footer-info pt-2">
                        <div class="price-tag" style="font-size: 16px;">$135<span>/hora</span></div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="car-card-collection" onclick="alugarCarro('Porsche 718 GTS')">
                    <h6 class="fw-bold mb-0">Porsche 718</h6>
                    <small class="text-muted" style="font-size: 11px;">GTS 4.0</small>
                    <div class="car-img-container" style="height: 110px; margin: 15px 0;">
                        <img src="/images/7.png" onerror="this.src='https://images.unsplash.com/photo-1526726538690-5cbf956ae2fd?w=400'" alt="Porsche 718">
                    </div>
                    <div class="collection-specs">
                        <span><i class="fa-solid fa-user"></i> 2</span>
                        <span><i class="fa-solid fa-gear"></i> A.</span>
                        <span><i class="fa-solid fa-droplet"></i> 200m/d</span>
                    </div>
                    <div class="car-footer-info pt-2">
                        <div class="price-tag" style="font-size: 16px;">$950<span>/dia</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="customAlert" class="custom-alert">
        <i class="fa-solid fa-circle-info text-info fs-5"></i>
        <span id="alertMessage">Ação realizada com sucesso!</span>
    </div>

    <script>
        function mostrarAlerta(mensagem) {
            const alertBox = document.getElementById('customAlert');
            const alertMessage = document.getElementById('alertMessage');
            
            alertMessage.textContent = mensagem;
            alertBox.classList.add('show');
            
            setTimeout(() => {
                alertBox.classList.remove('show');
            }, 3500);
        }

        function mudarAba(event, nomeAba) {
            event.preventDefault();
            document.querySelectorAll('.nav-links a').forEach(el => el.classList.remove('active'));
            event.currentTarget.classList.add('active');
            mostrarAlerta(`Navegando para a seção: ${nomeAba}`);
        }

        function realizarBusca() {
            mostrarAlerta('Buscando veículos disponíveis para os filtros selecionados...');
        }

        function alugarCarro(nomeCarro) {
            mostrarAlerta(`Redirecionando para o processo de reserva do veículo: ${nomeCarro}`);
        }
    </script>
    <script src="/js/core.js"></script>
</body>
</html>